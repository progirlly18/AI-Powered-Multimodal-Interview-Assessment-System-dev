# Optional settings for AI Interview Practice. Copy the lines you need into
# your shell environment (PowerShell: $env:NAME = "value").
# The app needs no API keys or other secrets.

# Webcam index (0 = default camera)
INTERVIEW_AI_CAMERA_INDEX=0

# Whisper model: tiny, base, small or medium (larger = slower, more accurate)
INTERVIEW_AI_WHISPER_MODEL=base

# Transcription language code (the question bank is in English)
INTERVIEW_AI_LANGUAGE=en

# Seconds between face analyses during recording (0.05-2.0)
INTERVIEW_AI_VISION_INTERVAL=0.33

# Maximum live video refresh rate in the browser (1-30)
INTERVIEW_AI_DISPLAY_FPS=10

# Countdown before each recording, in seconds (0-10)
INTERVIEW_AI_COUNTDOWN=3

# Keep a copy of each answer's audio (WAV) on disk. Off by default.
INTERVIEW_AI_KEEP_RECORDINGS=false
# Folder for kept recordings (git-ignored by default)
INTERVIEW_AI_RECORDINGS_DIR=

# Seconds between facial-expression predictions (0-10; the model costs ~0.3 s per call)
INTERVIEW_AI_EMOTION_INTERVAL=1.0

# Location of the local history database (scores and feedback only)
INTERVIEW_AI_HISTORY_PATH=

# ---- Sign-in (passwordless email codes; see docs/AUTH.md) ----
# Sign-in is required by default. Set to false only on a private, single-user computer.
INTERVIEW_AI_REQUIRE_SIGN_IN=true
# SMTP account that sends the codes. Prefer .streamlit/secrets.toml for these.
INTERVIEW_AI_SMTP_HOST=
INTERVIEW_AI_SMTP_PORT=587
INTERVIEW_AI_SMTP_SECURITY=starttls
INTERVIEW_AI_SMTP_USERNAME=
# Placeholder only - never commit a real password. Use an app password.
INTERVIEW_AI_SMTP_PASSWORD=
INTERVIEW_AI_SMTP_SENDER=
# Optional: only allow these domains, comma-separated (e.g. cmrit.ac.in)
INTERVIEW_AI_ALLOWED_EMAIL_DOMAINS=
# Location of the sign-in database (users and pending code hashes)
INTERVIEW_AI_AUTH_DB_PATH=
