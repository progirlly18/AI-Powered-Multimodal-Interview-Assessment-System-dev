# Copy to .streamlit/secrets.toml (git-ignored) and fill in. Environment
# variables with the INTERVIEW_AI_ prefix override these values.
[auth]
smtp_host = "smtp.gmail.com"
smtp_port = 587
smtp_security = "starttls"
smtp_username = "your.address@gmail.com"
smtp_password = "your 16-character app password"
# smtp_sender = "HUMAN NEXT <your.address@gmail.com>"
# allowed_email_domains = "cmrit.ac.in"
